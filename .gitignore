# Keep small hand-authored .NET tool projects under Assets, but ignore their build output.
!/Assets/Tools~/**/*.csproj
/Assets/Tools~/**/bin/
/Assets/Tools~/**/obj/

# Unity crash / misc
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# Local duplicate / backup folder (not part of the active project)
/TBS Framework - Copy/

# .NET tool build output
/Tools/**/bin/
/Tools/**/obj/

# Non-publishable local assets
/Assets/Game/Non-Publishable/

/Docs/
